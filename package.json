{
  "name": "aixmath.org",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8120",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 8120 --allowed-hosts aixmath.org,www.aixmath.org",
    "start": "astro preview --host 127.0.0.1 --port ${PORT:-8120} --allowed-hosts aixmath.org,www.aixmath.org"
  },
  "dependencies": {
    "astro": "^5.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.2"
  }
}
